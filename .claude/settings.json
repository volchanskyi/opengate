      "Bash(awk:*)",
      "Bash(bash:*)",
      "Bash(bats:*)",
      "Bash(cargo-deny:*)",
      "Bash(cargo:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod +x:*)",
      "Bash(command:*)",
      "Bash(conftest:*)",
      "Bash(curl:*)",
      "Bash(diffstat:*)",
      "Bash(docker:*)",
      "Bash(dpkg:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(gitleaks:*)",
      "Bash(go-arch-lint:*)",
      "Bash(go:*)",
      "Bash(gofmt:*)",
      "Bash(goimports:*)",
      "Bash(gosec:*)",
      "Bash(govulncheck:*)",
      "Bash(gremlins:*)",
      "Bash(grep:*)",
      "Bash(journalctl:*)",
      "Bash(kill:*)",
      "Bash(ldd:*)",
