# Local-only environment for the developer machine. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real values. Deployed environments take
# their secrets from the Kubernetes Secret instead (deploy/helm/opengate/secrets.example.yaml).
#
# scripts/precommit-gauntlet.sh sources `.env` when it exists, so these are
# available to every check it runs.

# SonarCloud user token for `make sonar`. Generate at
# https://sonarcloud.io/account/security scoped to the `volchanskyi` organization.
SONAR_TOKEN=changeme

# Postgres instance the Go integration tests run against. Leave unset to have
# server/internal/testpg start a throwaway postgres:17 container per run.
# POSTGRES_TEST_URL=postgres://opengate:changeme@localhost:5432/opengate?sslmode=disable
