# Copy to `.env` (gitignored) and fill in; scripts/precommit-gauntlet.sh sources it for every check.

# SonarCloud user token for `make sonar`, scoped to the `volchanskyi` organization.
SONAR_TOKEN=changeme

# Postgres the Go integration tests use; unset, server/internal/testpg starts a throwaway container.
# POSTGRES_TEST_URL=postgres://opengate:changeme@localhost:5432/opengate?sslmode=disable
