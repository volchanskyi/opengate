{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "On-demand raw-log broker pull rate by outcome, from the server opengate_device_log_pulls_total counter (requires the server /metrics scrape). The ok series is the audited-read rate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "pulls / sec",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "reqps",
          "min": 0
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Raw-log pull rate (by outcome)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "sum by (result) (rate(opengate_device_log_pulls_total{namespace=\"$environment\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "Raw-log broker pull latency (p99) from opengate_device_log_pull_duration_seconds. The blocking single-flight waiter is bounded by the 15s server fetch timeout.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "seconds",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "s",
          "min": 0,
          "noValue": "No pulls in this window"
        }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "Raw-log pull latency p99",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(opengate_device_log_pull_duration_seconds_bucket{namespace=\"$environment\"}[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "Audited raw-log reads: every successful pull writes exactly one device.logs.read audit event, so the ok-pull count over the window is the audit-event volume.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "title": "Audited raw-log reads (last 1h)",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
          "expr": "sum(increase(opengate_device_log_pulls_total{namespace=\"$environment\",result=\"ok\"}[1h]))",
          "legendFormat": "audited reads",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["edge-sentinel", "logs", "victoriametrics"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "description": "Production and staging write into one store. Every panel reads the one chosen here.",
        "type": "custom",
        "query": "Production : opengate, Staging : opengate-staging",
        "current": { "selected": true, "text": "Production", "value": "opengate" },
        "options": [
          { "selected": true, "text": "Production", "value": "opengate" },
          { "selected": false, "text": "Staging", "value": "opengate-staging" }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Edge-Sentinel Logs",
  "uid": "opengate-edge-logs",
  "version": 1
}
