{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(rate(opengate_http_requests_total{namespace=\"$environment\"}[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "title": "HTTP Request Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(opengate_http_request_duration_seconds_bucket{namespace=\"$environment\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(opengate_http_request_duration_seconds_bucket{namespace=\"$environment\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(opengate_http_request_duration_seconds_bucket{namespace=\"$environment\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5 }
        },
        "overrides": []
      }
    },
    {
      "title": "Connected Agents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "opengate_agents_connected{namespace=\"$environment\"}", "legendFormat": "Agents" }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      }
    },
    {
      "title": "Active Relay Sessions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "opengate_relay_active_sessions{namespace=\"$environment\"}", "legendFormat": "Sessions" }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      }
    },
    {
      "title": "MPS Devices",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "opengate_mps_connected_devices{namespace=\"$environment\"}", "legendFormat": "MPS Devices" }
      ],
      "fieldConfig": {
        "defaults": { "thresholds": { "steps": [{ "color": "purple", "value": null }] } },
        "overrides": []
      }
    },
    {
      "title": "HTTP Requests by Route (Top 10)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "topk(10, sum(rate(opengate_http_requests_total{namespace=\"$environment\"}[5m])) by (route))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      }
    },
    {
      "title": "Go Goroutines",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "go_goroutines{namespace=\"$environment\",job=\"opengate-server\"}", "legendFormat": "goroutines" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line" } }, "overrides": [] }
    },
    {
      "title": "Go Memory (Heap)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "go_memstats_heap_alloc_bytes{namespace=\"$environment\",job=\"opengate-server\"}", "legendFormat": "heap alloc" },
        { "expr": "go_memstats_heap_sys_bytes{namespace=\"$environment\",job=\"opengate-server\"}", "legendFormat": "heap sys" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "opengate_db_size_bytes{namespace=\"$environment\"}", "legendFormat": "DB Size" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 104857600 },
              { "color": "red", "value": 524288000 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Relay sessions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "description": "Sessions open is the highest count each pod held in each step. A session that echoes once and closes inside a second is open at almost none of the 15-second readings, so sessions started per minute is what says the relay was used. Started minus ended is what is open.",
      "interval": "15s",
      "targets": [
        {
          "expr": "max by (pod) (max_over_time(opengate_relay_active_sessions{namespace=\"$environment\"}[$__interval]))",
          "legendFormat": "{{pod}} open"
        },
        {
          "expr": "60 * sum by (pod) (rate(opengate_relay_sessions_started_total{namespace=\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} started / min"
        }
      ],
      "fieldConfig": {
        "defaults": { "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["opengate"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "description": "Production and staging write into one store. Every panel reads the one chosen here.",
        "type": "custom",
        "query": "Production : opengate, Staging : opengate-staging",
        "current": { "selected": true, "text": "Production", "value": "opengate" },
        "options": [
          { "selected": true, "text": "Production", "value": "opengate" },
          { "selected": false, "text": "Staging", "value": "opengate-staging" }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "OpenGate Overview",
  "uid": "opengate-overview"
}
