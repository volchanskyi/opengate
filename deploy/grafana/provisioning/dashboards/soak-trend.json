{
  "annotations": {
    "list": []
  },
  "description": "The weekly endurance run, one point per run, measured on the compose stack on a CI runner over five hours of churn.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Workflow",
      "url": "https://github.com/volchanskyi/opengate/actions/workflows/soak.yml",
      "targetBlank": true,
      "type": "link"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "How long the server took to write a machine's row, the slowest twentieth, as the server measured it. A leg that holds its load fails its night past three times the median of its last fourteen; a saturated leg is reported.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "milliseconds",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false
          },
          "unit": "ms",
          "min": 0,
          "noValue": "No run published in this range"
        }
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "title": "Registration tail (p95)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "perf_latency_p95_ms{env=\"ci\",phase=\"register\",leg=\"soak\"}[$__range]",
          "instant": true,
          "range": false,
          "legendFormat": "{{leg}} {{phase}} {{workload}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
