# Copy to backend.tfbackend (gitignored); namespace: `oci os ns get --query data --raw-output`.
# The credentials file holds the tf-state-writer user's S3-compatible Customer Secret Key.

endpoints = {
  s3 = "https://<namespace>.compat.objectstorage.us-sanjose-1.oraclecloud.com"
}
shared_credentials_files = ["~/.oci/terraform-credentials"]
