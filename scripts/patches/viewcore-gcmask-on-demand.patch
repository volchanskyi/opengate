 	return r.reg.Field("GCData").Address()
 }
 
+// gcMask returns where the pointer bitmask of a type lives, given the type's
+// GCData field and TFlag, and whether there is a bitmask to read at all.
+//
+// A type with more pointer words than internal/abi.MaxPtrmaskBytes*8 carries
+// internal/abi.TFlagGCMaskOnDemand. Its GCData then points at a slot holding
+// the address of a bitmask the runtime builds the first time it needs one, and
+// the slot is nil until then, or runtime.inProgress while it is being built.
+func (p *Process) gcMask(gcdata core.Address, tflag uint8) (core.Address, bool) {
+	onDemand, ok := p.rtConsts.find("internal/abi.TFlagGCMaskOnDemand")
+	if !ok || tflag&uint8(onDemand) == 0 {
+		return gcdata, true
+	}
+	mask := p.proc.ReadPtr(gcdata)
+	if building, ok := p.rtGlobals["inProgress"]; ok && mask == building.a {
+		return 0, false
+	}
+	return mask, mask != 0
+}
