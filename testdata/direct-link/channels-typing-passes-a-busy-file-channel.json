{
  "description": "With a channel per job, a keystroke echo reaches the browser while the file channel is still carrying earlier frames, and each channel keeps its own order.",
  "steps": [
    {
      "step": "begin",
      "side": "both"
    },
    {
      "step": "open",
      "side": "both",
      "channels": "separate"
    },
    {
      "step": "settle"
    },
    {
      "step": "queue",
      "side": "host",
      "lane": "bulk",
      "frames": [
        {
          "label": "f1",
          "size": 40000
        },
        {
          "label": "f2",
          "size": 40000
        }
      ]
    },
    {
      "step": "queue",
      "side": "host",
      "lane": "screen",
      "frames": [
        {
          "label": "s1",
          "size": 20000
        }
      ]
    },
    {
      "step": "queue",
      "side": "host",
      "lane": "interactive",
      "frames": [
        {
          "label": "t1"
        }
      ]
    },
    {
      "step": "take",
      "side": "host"
    },
    {
      "step": "carry",
      "path": "link",
      "channel": "typing",
      "to": "browser"
    },
    {
      "step": "expect",
      "side": "browser",
      "delivered": [
        "t1"
      ]
    },
    {
      "step": "carry",
      "path": "link",
      "channel": "screen",
      "to": "browser"
    },
    {
      "step": "carry",
      "path": "link",
      "channel": "files",
      "to": "browser",
      "count": 3
    },
    {
      "step": "expect",
      "side": "browser",
      "delivered": [
        "t1",
        "s1",
        "f1"
      ]
    },
    {
      "step": "settle"
    },
    {
      "step": "tick",
      "ms": 250
    },
    {
      "step": "settle"
    }
  ],
  "expect": {
    "browser": {
      "delivered": [
        "t1",
        "s1",
        "f1",
        "f2"
      ],
      "path": "link",
      "outcomes": [
        "direct"
      ]
    },
    "host": {
      "delivered": [],
      "path": "link",
      "outcomes": [
        "direct"
      ],
      "kept": 0
    }
  }
}
