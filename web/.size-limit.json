[
  { "name": "Initial JS (entry chunk, first paint)", "path": "dist/assets/index-*.js",                                 "limit": "100 KB", "gzip": true },
  { "name": "All app JS (excl. charts)",             "path": ["dist/assets/*.js", "!dist/assets/charts-*.js"],        "limit": "250 KB", "gzip": true },
  { "name": "Charts chunk (lazy uPlot)",             "path": "dist/assets/charts-*.js",                               "limit": "30 KB",  "gzip": true },
  { "name": "CSS bundle",                            "path": "dist/assets/*.css",                                     "limit": "12 KB",  "gzip": true }
]
